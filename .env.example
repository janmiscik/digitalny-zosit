DATABASE_URL=sqlite:///./digitalny-zosit.db

# Vygeneruj bezpečný náhodný reťazec, napr.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Session cookie posielať iba cez HTTPS. V produkcii (Railway) nechaj
# true. Iba ak vyvíjaš lokálne cez obyčajné http://localhost, nastav
# na false, inak sa neprihlásiš (prehliadač cookie cez http neuloží).
SESSION_HTTPS_ONLY=true

ADMIN_USERNAME=admin

# Hash hesla vygeneruješ príkazom:
# python -c "from auth import hash_password; print(hash_password('tvoje-heslo'))"
ADMIN_PASSWORD_HASH=change-me