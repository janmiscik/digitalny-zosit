# Vygeneruj bezpečný náhodný reťazec, napr.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Session cookie posielať iba cez HTTPS. V produkcii nechaj true.
# Iba ak vyvíjaš lokálne cez obyčajné http://localhost, nastav na
# false, inak sa neprihlásiš (prehliadač cookie cez http neuloží).
SESSION_HTTPS_ONLY=true

# =========================================
# MULTI-TENANT (kontá)
#
# Appka má DVE oddelené databázy:
#   1. ACCOUNTS_DATABASE_URL - master databáza kont (meno, hash hesla)
#   2. každé konto má svoj vlastný súbor s business dátami (faktúry,
#      zákazníci...) pod ACCOUNTS_DATA_DIR/<slug>/database.db
#
# Pred prvým spustením appky treba databázu kont inicializovať:
#
#     alembic -c alembic_accounts.ini upgrade head
#
# Jednotlivé kontá (ich vlastné databázy) appka migruje automaticky
# pri registrácii (tenancy.provision_account) - nič ďalšie netreba
# spúšťať ručne, OKREM prípadu, keď appku nasadíš s NOVOU migráciou
# pre databázy kont (pozri manage_accounts.py --upgrade-all).
# =========================================

ACCOUNTS_DATABASE_URL=sqlite:///./data/accounts.db
ACCOUNTS_DATA_DIR=./data/accounts

# Používa sa len pri priamom vývojárskom CLI príkaze
# `alembic upgrade head` (bez -c alembic_accounts.ini) mimo bežiacej
# appky - appka v behu toto nepoužíva (viď database.py).
DATABASE_URL=sqlite:///./digitalny-zosit.db
